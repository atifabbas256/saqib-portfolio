# Your Shopify store domain, e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (Settings > Apps > Develop apps > your app > Storefront API)
# This is a PUBLIC token meant for client apps - it only grants read/cart-write scopes,
# never use your Admin API token here.
SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# Storefront API version, keep reasonably current
SHOPIFY_API_VERSION=2024-10
